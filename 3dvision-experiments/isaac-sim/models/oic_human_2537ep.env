# oic_human_2537ep — object-in-container finetune on 2537 human (Aria egocentric) episodes.
# Far more data than the 5-ep model, so much better at localizing the object. NOTE: trained
# on a human hand, so its 17-dim hand output won't map cleanly to the FR3 gripper — judge it
# on ARM reaching, not grasping. Norm stats come from the checkpoint's own assets dir.
# Paths are CONTAINER paths (/checkpoints is bound to rytsui's checkpoints by submit.sh).
export MODEL_NAME=oic_human_2537ep
export CONFIG_NAME=pi05_ego_human_oic
export CHECKPOINT_DIR=/checkpoints/pi05_ego_human_oic/human_oic/29999
export NORM_STATS_DIR=/checkpoints/pi05_ego_human_oic/human_oic/29999/assets/egoverse/oic_human
export PROMPT="put the object in the bowl"
