# oic_human_2537ep — object-in-container finetune on 2537 human (Aria egocentric) episodes.
# 6-dim single-arm cartesian model (state/action = [pos, euler], NO hand) — so it needs the
# DEDICATED script eval_script_oic.py, NOT the main 24-dim eval:
#   sbatch ... submit.sh eval_script_oic.py oic_human_2537ep
# Far more data than the 5-ep model -> better object localization. Euler order/frame are
# unresolved; eval_script_oic.py sweeps EULER_ORDER at startup. Prompt matches the training
# task label ('put the object in the container'). Norm stats come from the checkpoint.
# Paths are CONTAINER paths (/checkpoints is bound to rytsui's checkpoints by submit.sh).
export MODEL_NAME=oic_human_2537ep
export CONFIG_NAME=pi05_ego_human_oic
export CHECKPOINT_DIR=/checkpoints/pi05_ego_human_oic/human_oic/29999
export NORM_STATS_DIR=/checkpoints/pi05_ego_human_oic/human_oic/29999/assets/egoverse/oic_human
export PROMPT="put the object in the container"
