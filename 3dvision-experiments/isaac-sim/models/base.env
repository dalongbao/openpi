# base — untrained pi0.5 (no finetuning), for "did finetuning help?" comparisons.
#
# NOTE: base loads differently from the LoRA finetunes — it needs the plain-gemma
# variant swap (LoRA adapters init to zero), which lives in the dedicated script
# eval_script_base_object_in_bowl.py. So run base with THAT script, not the main eval:
#   sbatch ... submit.sh eval_script_base_object_in_bowl.py base
# (/base_weights is bound by submit.sh to the pi05_base_jax orbax params.)
export MODEL_NAME=base
export CONFIG_NAME=pi05_egoverse
export CHECKPOINT_DIR=/base_weights
export NORM_STATS_DIR=          # empty -> config default asset dir
export PROMPT="put the object in the bowl"
