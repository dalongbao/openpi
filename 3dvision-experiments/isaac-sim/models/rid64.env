# rid64 — R_ID (robot object_in_bowl) finetune on the FULL 64 teleop episodes, step 30000.
# Strongest robot model (most data + full schedule) -> the best-case "what can the robot
# model do in sim". Same 24-dim arm+hand as rid30/egoverse_5ep -> run with the main eval,
# arm VISIBLE:
#   SCENE_FIDELITY=1 sbatch ... submit.sh eval_script_object_in_bowl.py rid64
#
# Trained by a teammate (lichin), so the checkpoint is in the SHARED scratch tree, bound at
# /shared_checkpoints by submit.sh (default SHARED_CHECKPOINTS=/cluster/scratch/lichin/checkpoints;
# override that env if the owner differs). Needs read access to that dir.
#
# Config is the canonical pi05_egoverse (rid64 is the unweighted 64-ep point, not a subset
# config). Norm stats from the in-checkpoint snapshot (egoverse/all).
export MODEL_NAME=rid64
export CONFIG_NAME=pi05_egoverse
export CHECKPOINT_DIR=/shared_checkpoints/pi05_egoverse/rid64/30000
export NORM_STATS_DIR=/shared_checkpoints/pi05_egoverse/rid64/30000/assets/egoverse/all
export PROMPT="put the object in the bowl"
