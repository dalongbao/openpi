# egoverse_5ep — the original object_in_bowl finetune (5 teleop episodes).
# Weak model (real-frame cosine ~0.385); useful as the low-data baseline.
# Paths are CONTAINER paths (valid inside apptainer via submit.sh's binds).
export MODEL_NAME=egoverse_5ep
export CONFIG_NAME=pi05_egoverse
export CHECKPOINT_DIR=/checkpoints/pi05_egoverse/test/29999
export NORM_STATS_DIR=          # empty -> config default: /workspace/openpi/assets/pi05_egoverse/egoverse/all
export PROMPT="put the object in the bowl"
