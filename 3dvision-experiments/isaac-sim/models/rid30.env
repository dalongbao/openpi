# rid30 — R_ID (robot object_in_bowl) finetune on 30 teleop episodes, config pi05_egoverse_n30.
# Same 24-dim action space as egoverse_5ep (7 EE-pose + 17 ORCA hand) -> run with the main
# 24-dim eval, arm VISIBLE (this is robot data):
#   SCENE_FIDELITY=1 sbatch ... submit.sh eval_script_object_in_bowl.py rid30
# More data than the 5-ep model (which froze at the training mean) -> the model worth a sim test.
#
# Trained by THIS user, so the checkpoint lives in your OWN scratch, bound at /user_checkpoints
# by submit.sh (NOT rytsui's /checkpoints). Training was capped at step 20000 (24h wall);
# update the step below if a later checkpoint exists (see the find command in the README).
#
# NORM_STATS_DIR points at the snapshot saved INSIDE the checkpoint so the eval normalizer
# exactly matches what training used. pi05_egoverse_n30 shares repo_id "egoverse/all", so the
# snapshot lives under assets/egoverse/all/ next to params/.
export MODEL_NAME=rid30
export CONFIG_NAME=pi05_egoverse_n30
export CHECKPOINT_DIR=/user_checkpoints/pi05_egoverse_n30/rid30/20000
export NORM_STATS_DIR=/user_checkpoints/pi05_egoverse_n30/rid30/20000/assets/egoverse/all
export PROMPT="put the object in the bowl"
